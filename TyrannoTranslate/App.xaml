<Application x:Class="TyrannoTranslate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgDark" Color="#1E1E2E" po:Freeze="False"/>
            <SolidColorBrush x:Key="BgPanel" Color="#252536" po:Freeze="False"/>
            <SolidColorBrush x:Key="BgRowAlt" Color="#2A2A3C" po:Freeze="False"/>
            <SolidColorBrush x:Key="BgRow" Color="#232334" po:Freeze="False"/>
            <SolidColorBrush x:Key="BorderColor" Color="#3D3D5C" po:Freeze="False"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#E8E8F0" po:Freeze="False"/>
            <SolidColorBrush x:Key="TextMuted" Color="#9090A8" po:Freeze="False"/>
            <SolidColorBrush x:Key="Accent" Color="#7C9EFF" po:Freeze="False"/>
            <SolidColorBrush x:Key="HeaderBg" Color="#2D2D44" po:Freeze="False"/>
            <SolidColorBrush x:Key="TagHighlight" Color="#4A5568" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#252536" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E8E8F0" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3D3D58" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D3D58" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#353548" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8E8F0" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252536" po:Freeze="False"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8F0" po:Freeze="False"/>
            <SolidColorBrush x:Key="SelectionBackground" Color="#3D3D58" po:Freeze="False"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF" po:Freeze="False"/>
            <SolidColorBrush x:Key="ButtonBackground" Color="#353548" po:Freeze="False"/>
            <SolidColorBrush x:Key="ButtonHover" Color="#454560" po:Freeze="False"/>
            <SolidColorBrush x:Key="ButtonPressed" Color="#2A2A3E" po:Freeze="False"/>
            <SolidColorBrush x:Key="ErrorText" Color="#FF6B6B" po:Freeze="False"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
