<Window x:Class="TyrannoTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TyrannoTranslate"
        Height="720" Width="1200"
        MinHeight="480" MinWidth="900"
        Icon="Icon/logo.ico"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open .ks..." Click="OpenFile_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Click="SaveFile_Click" InputGestureText="Ctrl+S" x:Name="SaveMenuItem"/>
                <MenuItem Header="Save _As..." Click="SaveAsFile_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Copy original → translation (selected)" Click="CopyOriginal_Click"/>
                <MenuItem Header="_Auto-populate..." Click="AutoPopulate_Click"/>
                <Separator/>
                <MenuItem Header="Filter: _untranslated only" Click="ToggleFilter_Click" x:Name="FilterMenuItem" IsCheckable="True"/>
                <MenuItem Header="Create .bak backup on save (once)" Click="ToggleBackup_Click" x:Name="BackupMenuItem" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Create .baktl progress snapshot on save" Click="ToggleProgressBackup_Click" x:Name="ProgressBackupMenuItem" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="{StaticResource BgPanel}">
            <Button Content="Open" Click="OpenFile_Click" Style="{StaticResource ToolbarButtonStyle}"/>
            <Button Content="Save" Click="SaveFile_Click" Style="{StaticResource ToolbarButtonStyle}"/>
            <Separator/>
            <TextBlock Text="File:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextMuted}"/>
            <TextBlock x:Name="FilePathText" Text="(no file)" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
        </ToolBar>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource TextMuted}" Margin="0,0,12,0">
                        <Run Text="Rows:"/>
                        <Run x:Name="RowCountRun" Text="0"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource Accent}">
                        <Run Text="Translated:"/>
                        <Run x:Name="TranslatedCountRun" Text="0"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Text="Edit translations in the right column. Drag row headers to resize rows. Tyrano tags in [brackets] must stay identical to the original line."/>

            <DataGrid x:Name="TranslationGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="True"
                      HeadersVisibility="All"
                      RowHeaderWidth="20"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{StaticResource BorderColor}"
                      VerticalGridLinesBrush="{StaticResource BorderColor}"
                      Background="{StaticResource BgRow}"
                      RowBackground="{StaticResource BgRow}"
                      AlternatingRowBackground="{StaticResource BgRowAlt}"
                      BorderBrush="{StaticResource BorderColor}"
                      BorderThickness="1"
                      Foreground="{StaticResource TextPrimary}"
                      SelectionMode="Extended"
                      SelectionUnit="Cell"
                      ClipboardCopyMode="ExcludeHeader"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      MinRowHeight="28"
                      FontFamily="Segoe UI"
                      FontSize="13">
                <DataGrid.RowHeaderStyle>
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.RowHeaderStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A55"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="48" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ln" Binding="{Binding FileLineIndex, Converter={StaticResource LineDisplayConverter}}" Width="48" IsReadOnly="True"/>
                    <DataGridTextColumn Header="St" Binding="{Binding Status}" Width="36" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Original" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Original, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyOriginalTextStyle}"
                                         PreviewMouseLeftButtonDown="OriginalText_PreviewMouseLeftButtonDown"
                                         PreviewMouseRightButtonDown="CellText_PreviewMouseRightButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Translation" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewMouseLeftButtonDown="TranslationText_PreviewMouseLeftButtonDown"
                                         PreviewMouseRightButtonDown="CellText_PreviewMouseRightButtonDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource EditableTranslationTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
