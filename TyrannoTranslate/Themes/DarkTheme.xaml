    <Geometry x:Key="MenuIconFilter">M1.5,2 H14.5 L9.5,8 V13 L6.5,14 V8 Z</Geometry>
    <Geometry x:Key="MenuIconBackup">M2,4 H14 V14 H2 Z M2,4 L4,1.5 H12 L14,4 M5,7 H11 M5,10 H11</Geometry>
