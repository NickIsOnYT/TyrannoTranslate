    <Geometry x:Key="MenuIconForce">M9,1.5 L3,9 H7 L6,14.5 L13,6.5 H9 Z</Geometry>
    <Geometry x:Key="MenuIconExit">M8,2 H14 V14 H8 M8,8 H1.5 M4.5,5 L1.5,8 L4.5,11</Geometry>
