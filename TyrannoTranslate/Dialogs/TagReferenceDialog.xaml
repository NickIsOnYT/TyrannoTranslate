<Window x:Class="TyrannoTranslate.Dialogs.TagReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TyranoScript Tags Reference"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ContentScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Margin="0,0,8,0"/>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Click="Close_Click" MinWidth="90" Margin="0,12,0,0"
                HorizontalAlignment="Right" Style="{StaticResource ToolbarButtonStyle}" Padding="14,5"/>
    </Grid>
</Window>
