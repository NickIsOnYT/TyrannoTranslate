<Window x:Class="TyrannoTranslate.Dialogs.SuperImporterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuperImporter"
        Height="300" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"
                   Text="Export your current translations to a translation memory file, or import one to fill matching originals (exact match only)."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ExportButton" Content="Export translations..." Click="Export_Click"
                    Style="{StaticResource ToolbarButtonStyle}" MinWidth="140" Padding="14,6"/>
            <Button x:Name="ImportButton" Content="Import from file..." Click="Import_Click"
                    Style="{StaticResource ToolbarButtonStyle}" MinWidth="140" Padding="14,6" Margin="12,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="SourceFileText" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>

        <CheckBox x:Name="SkipFilledBox" Grid.Row="3" Content="Don't replace filled translations" Margin="0,0,0,8"
                  Foreground="{DynamicResource TextPrimary}" IsChecked="True"/>

        <TextBlock x:Name="MatchCountText" Grid.Row="4" Foreground="{DynamicResource Accent}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Click="Close_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
