<Window x:Class="TyrannoTranslate.Dialogs.TranslateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translate"
        Height="660" Width="860"
        MinHeight="460" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Translation provider:" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,0,8,0"/>
<ComboBox x:Name="ProviderCombo" MinWidth="180"
          DisplayMemberPath="Name"
          Background="White" Foreground="Black"
          SelectionChanged="ProviderCombo_SelectionChanged"/>
            <TextBlock x:Name="ProviderDescText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontSize="12"
                       Margin="10,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectAllButton" Content="Select All" Click="SelectAll_Click"
                    Style="{StaticResource ToolbarButtonStyle}" MinWidth="90" Padding="12,5"/>
            <Button x:Name="DeselectAllButton" Content="Deselect All" Click="DeselectAll_Click"
                    Style="{StaticResource ToolbarButtonStyle}" MinWidth="90" Padding="12,5" Margin="8,0,0,0"/>
            <TextBlock x:Name="SelectedCountText" Text="0 selected"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource Accent}" FontSize="13"/>
        </StackPanel>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="True"
                  HeadersVisibility="All"
                  RowHeaderWidth="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                  VerticalGridLinesBrush="{DynamicResource BorderColor}"
                  Background="{DynamicResource BgRow}"
                  RowBackground="{DynamicResource BgRow}"
                  AlternatingRowBackground="{DynamicResource BgRowAlt}"
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="1"
                  Foreground="{DynamicResource TextPrimary}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  MinRowHeight="26"
                  FontFamily="Segoe UI"
                  FontSize="13"
                  HorizontalScrollBarVisibility="Disabled">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3A3A55"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimary}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="44" IsReadOnly="True"/>
                <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Translation" Binding="{Binding Translated}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Source language:" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" FontSize="13"/>
                <ComboBox x:Name="SourceLangCombo"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Code"
                          SelectedIndex="0"
                          Background="White" Foreground="Black"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="→" FontSize="28" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource TextMuted}" Margin="16,0" Padding="0,0,0,4"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Target language:" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" FontSize="13"/>
                <ComboBox x:Name="TargetLangCombo"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Code"
                          SelectedIndex="1"
                          Background="White" Foreground="Black"/>
            </StackPanel>
        </Grid>

        <!-- Provider-specific settings panel -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Argos Translate -->
            <Grid x:Name="ArgosSettings" Grid.ColumnSpan="3" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Model path:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <TextBox x:Name="ModelPathBox" Grid.Column="1"
                         Style="{StaticResource DialogTextBoxStyle}"
                         FontSize="12" VerticalAlignment="Center" TextChanged="ModelPathBox_TextChanged"/>
                <Button Grid.Column="2" Content="Browse..." Click="BrowseModelPath_Click"
                        Style="{StaticResource ToolbarButtonStyle}" Padding="10,3" Margin="6,0,0,0"/>
            </Grid>

            <!-- Google Cloud Translation -->
            <Grid x:Name="GoogleSettings" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="API key:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <PasswordBox x:Name="GoogleApiKeyBox" Grid.Column="1"
                             Style="{StaticResource DialogPasswordBoxStyle}"
                             FontSize="12" VerticalAlignment="Center"
                             PasswordChanged="GoogleApiKeyBox_PasswordChanged"/>
                <CheckBox x:Name="GoogleFreeCheck" Grid.Column="2" Content="Use free endpoint (no key needed)"
                          Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0"
                          VerticalAlignment="Center" IsChecked="True" FontSize="12"
                          Checked="GoogleFreeCheck_Changed" Unchecked="GoogleFreeCheck_Changed"/>
            </Grid>

            <!-- DeepL -->
            <Grid x:Name="DeepLSettings" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="API key:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                 <PasswordBox x:Name="DeepLApiKeyBox" Grid.Column="1"
                             Style="{StaticResource DialogPasswordBoxStyle}"
                             FontSize="12" VerticalAlignment="Center"
                             PasswordChanged="DeepLApiKeyBox_PasswordChanged"/>
                <CheckBox x:Name="DeepLFreeCheck" Grid.Column="2" Content="Use Free API"
                          Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0"
                          VerticalAlignment="Center" IsChecked="True" FontSize="12"
                          Checked="DeepLFreeCheck_Changed" Unchecked="DeepLFreeCheck_Changed"/>
            </Grid>

            <!-- LibreTranslate -->
            <Grid x:Name="LibreSettings" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Server URL:" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <TextBox x:Name="LibreUrlBox" Grid.Column="1"
                         Style="{StaticResource DialogTextBoxStyle}"
                         FontSize="12" VerticalAlignment="Center"
                         TextChanged="LibreUrlBox_TextChanged"/>
                <CheckBox x:Name="LibreRequiresKeyCheck" Grid.Column="2" Content="Requires API key"
                          Foreground="{DynamicResource TextMuted}" Margin="10,0,8,0"
                          VerticalAlignment="Center" FontSize="12"
                          Checked="LibreRequiresKeyCheck_Changed" Unchecked="LibreRequiresKeyCheck_Changed"/>
                <PasswordBox x:Name="LibreApiKeyBox" Grid.Column="3"
                             Style="{StaticResource DialogPasswordBoxStyle}"
                             FontSize="12" VerticalAlignment="Center"
                             PasswordChanged="LibreApiKeyBox_PasswordChanged"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TranslateButton" Grid.Column="0" Content="Translate Selected"
                    Click="Translate_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Height="38" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="ModelStatusText" Grid.Column="1"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="10,0,0,0"/>
        </Grid>

        <ProgressBar x:Name="ProgressBar" Grid.Row="6"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Height="4" Margin="0,0,0,6"
                     Foreground="{DynamicResource Accent}"
                     Background="{DynamicResource BorderColor}"/>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Select lines and languages, then click Translate."
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Close" Click="Close_Click" MinWidth="80"
                    Style="{StaticResource ToolbarButtonStyle}" Padding="14,5" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
